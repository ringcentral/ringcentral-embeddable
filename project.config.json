{
  "distPath": "dist",
  "buildPath": "build",
  "themePath": "./src",
  "pages": [
    {
      "index": "src/app.html",
      "main": "src/app.ts"
    },
    {
      "main": "src/adapter.ts",
      "filename": "adapter.js"
    },
    {
      "index": "src/redirect.html",
      "main": "src/redirect.ts"
    }
  ],
  "assets": [
    { "from": "src/popup.html", "to": "popup.html" },
    { "from": "src/index.html", "to": "index.html" },
    { "from": "src/plugins.json", "to": "plugins.json" },
    { "from": "src/assets", "to": "assets" }
  ],
  "environment": {
    "local": {
      "brand": ["rc"],
      "mode": "development"
    },
    "dev": {
      "brand": ["rc"],
      "mode": "production"
    },
    "prod": {
      "brand": ["rc"],
      "mode": "production"
    }
  },
  "appConfigPath": "src/config/index.ts",
  "devServerPort": 8080,
  "themeSystem": "spring-ui"
}
